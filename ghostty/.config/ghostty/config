# Font
font-family = Berkeley Mono
font-size = 10

# Window
macos-titlebar-style = tabs
window-padding-x = 14
window-padding-y = 14

# Cursor
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# Shell — independent of the macOS account shell.
command = /opt/homebrew/bin/fish -l

# Preserve Alt-h/j/k/l navigation across tmux and Neovim panes.
macos-option-as-alt = true

# Shell integration
shell-integration-features = no-cursor,ssh-env

# Keybindings

# Send Enter as a CSI-u (fixterms) sequence, so a TUI can tell the chord
# apart from a plain Enter. The parameter is 1 + a modifier bitmask
# (shift 1, alt 2), so ;2 is Shift+Enter and ;4 is Alt+Shift+Enter.
#
# Legacy encoding makes both chords ambiguous: Shift+Enter sends a bare
# CR, identical to Enter, and Alt+Shift+Enter sends ESC CR, identical to
# Alt+Enter. Neither reaches an application as a distinct key.
#
# The previous binding was `shift+enter=text:\n`. It sent a literal line
# feed, which works for newline-versus-submit but carries no modifier
# information and cannot express the Alt+Shift chord. Restore that line
# if an application shows a literal `[13;2u` instead of acting on the key.
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100
