# Runtime version manifest for this checkout.
#
# `scripts/setup-tools` reads this file. `scripts/doctor` compares the
# resolved runtime executables against these versions and reports drift.
#
# The manifest records the versions that a fresh bootstrap should
# install; it does NOT retroactively migrate an already-installed
# runtime. Volta keeps the existing default in place. To adopt a new
# version, edit the value here AND run `volta install <tool>@<version>`
# yourself.
#
# Format: KEY=VALUE, one per line, `#` opens a comment.

NODE_VERSION=22.14.0
PNPM_VERSION=10.15.0
YARN_VERSION=4.4.0
