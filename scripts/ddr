#!/usr/bin/env bash

# Delete deployment records - ddr
#
# Given "owner/repo", fetch deployment records via the GitHub API, present
# them interactively via fzf, and delete the selected records. This deletes
# deployment RECORDS only, not environments.
#
# Safety model:
#   - --help is handled before any prompt or network call.
#   - --dry-run performs zero mutation API calls (no POST, no DELETE).
#   - --yes (-y) opts into non-interactive deletion; without it, a typed
#     "yes" is read from /dev/tty. If no tty is available and --yes was
#     not passed, the script refuses.
#   - Fetch/parse/select run to completion before any mutation; upstream
#     failure cannot leave a partial deletion.
#   - The list endpoint does not return deployment statuses; we show the
#     metadata that IS available (id, created_at, environment, description,
#     ref) rather than pretending we have a status.
#
# Requires: gh, jq, fzf.

set -o errexit
set -o pipefail

PROG="${0##*/}"

DRY_RUN=0
ASSUME_YES=0
REPO=""

log() { printf '%s\n' "$*" >&2; }
err() { printf '%s: error: %s\n' "$PROG" "$*" >&2; }

usage() {
  cat <<EOF
Usage: $PROG [options] [owner/repo]

Interactively select GitHub deployment records via fzf, then delete them.

Options:
  -h, --help       Show this help and exit.
      --dry-run    List what would be deleted; make no mutation API calls.
  -y, --yes        Do not prompt for confirmation before deleting.

Arguments:
  owner/repo       Target repository. If omitted and stdin is a tty, you
                   will be prompted.

Exit codes:
  0  success (including "nothing selected")
  1  runtime failure (list, parse, or delete failed)
  2  usage error (bad flag, bad repo, missing repo without tty)
  3  aborted (confirmation declined or no tty for confirmation)
127  missing dependency

Output:
  Machine-readable deletion results go to stdout as TAB-separated lines:
    <RESULT>\t<id>\t<original selection line>
  where RESULT is OK, SKIP (dry-run), or BAD. Human narration goes to stderr.
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --dry-run) DRY_RUN=1; shift ;;
      -y|--yes)  ASSUME_YES=1; shift ;;
      --)        shift; break ;;
      -*)        err "unknown option: $1"; usage >&2; exit 2 ;;
      *)
        if [[ -z "$REPO" ]]; then
          REPO="$1"; shift
        else
          err "unexpected argument: $1"; exit 2
        fi
        ;;
    esac
  done
  if [[ $# -gt 0 ]]; then
    [[ $# -eq 1 && -z "$REPO" ]] || { err 'unexpected arguments'; exit 2; }
    REPO="$1"
  fi
}

check_deps() {
  local dep missing=0
  for dep in gh jq fzf; do
    if ! command -v "$dep" >/dev/null 2>&1; then
      err "missing dependency: $dep"
      missing=1
    fi
  done
  [[ $missing -eq 0 ]] || exit 127
}

resolve_repo() {
  if [[ -z "$REPO" ]]; then
    if [[ -t 0 ]]; then
      local owner name
      printf 'Enter owner: ' >&2
      IFS= read -r owner || { err "no repo provided"; exit 2; }
      printf 'Enter repo: ' >&2
      IFS= read -r name || { err "no repo provided"; exit 2; }
      REPO="$owner/$name"
    else
      err "repo required (pass owner/repo)"
      exit 2
    fi
  fi
  if ! [[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    err "invalid repo (expected owner/repo): $REPO"
    exit 2
  fi
}

jqscript() {
  cat <<'EOF'
    def tz:
      gsub("[TZ]"; " ");

    .[]
      | [
          (.id | tostring),
          (.created_at | tz),
          (.environment // "unknown"),
          (.description // "no description"),
          (.ref // "")
        ]
      | @tsv
EOF
}

confirm() {
  local count="$1"
  if [[ $ASSUME_YES -eq 1 || $DRY_RUN -eq 1 ]]; then
    return 0
  fi
  if [[ ! -r /dev/tty || ! -w /dev/tty ]]; then
    err "no tty available for confirmation; re-run with --yes to proceed non-interactively"
    exit 3
  fi
  local reply
  printf 'About to delete %d deployment record(s) from %s. Type "yes" to proceed: ' \
    "$count" "$REPO" >/dev/tty
  IFS= read -r reply </dev/tty || { err "aborted"; exit 3; }
  if [[ "$reply" != "yes" ]]; then
    err "aborted"
    exit 3
  fi
}

delete_one() {
  local line id
  line="$1"
  id="$(printf '%s' "$line" | cut -f 1)"
  if ! [[ "$id" =~ ^[0-9]+$ ]]; then
    printf 'BAD\t\t%s\n' "$line"
    return 1
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    printf 'SKIP\t%s\t%s\n' "$id" "$line"
    return 0
  fi

  # Add an inactive status before deleting the record. Do not log API bodies.
  if ! gh api -X POST "/repos/$REPO/deployments/$id/statuses" \
        -f state=inactive \
        -f description="Marked inactive for deletion" \
        >/dev/null 2>&1; then
    printf 'BAD\t%s\t%s\n' "$id" "$line"
    err "failed to mark deployment $id inactive"
    return 1
  fi

  sleep 0.5

  if gh api -X DELETE "/repos/$REPO/deployments/$id" >/dev/null 2>&1; then
    printf 'OK\t%s\t%s\n' "$id" "$line"
  else
    printf 'BAD\t%s\t%s\n' "$id" "$line"
    err "failed to delete deployment $id"
    return 1
  fi
}

main() {
  parse_args "$@"
  check_deps
  resolve_repo

  local raw parsed selection count line id failed=0

  log "Fetching deployment records for $REPO..."
  if ! raw=$(gh api --paginate "/repos/$REPO/deployments" 2>/dev/null); then
    err "failed to list deployments"
    exit 1
  fi

  # Validate JSON before parsing. Some jq builds return 0 on parse errors
  # unless -e is used; `jq -e type` reliably distinguishes invalid input.
  if ! printf '%s' "$raw" | jq -e type >/dev/null 2>&1; then
    err "failed to parse deployments (invalid JSON from gh)"
    exit 1
  fi
  if ! parsed=$(printf '%s' "$raw" | jq -r -f <(jqscript) 2>/dev/null); then
    err "failed to parse deployments"
    exit 1
  fi

  if [[ -z "$parsed" ]]; then
    log "no deployment records found"
    exit 0
  fi

  # Run selection to completion; capture full result before any mutation.
  if ! selection=$(printf '%s\n' "$parsed" | fzf --multi); then
    log "no selection; nothing to delete"
    exit 0
  fi
  if [[ -z "$selection" ]]; then
    log "no selection; nothing to delete"
    exit 0
  fi

  # Validate the complete selection before the first mutation.
  while IFS= read -r line; do
    id=$(printf '%s' "$line" | cut -f 1)
    if ! [[ "$id" =~ ^[0-9]+$ ]] || ! grep -Fqx -- "$line" <<< "$parsed"; then
      err 'invalid selection'; exit 1
    fi
  done <<< "$selection"
  count=$(printf '%s\n' "$selection" | grep -c .)
  printf 'Selected records in %s:\n%s\n' "$REPO" "$selection" >&2
  confirm "$count"

  if [[ $DRY_RUN -eq 1 ]]; then
    log "dry-run: no API mutations will be performed"
  fi

  # Iterate. Do not stream through a pipe so a mid-stream failure cannot
  # be triggered by upstream parsing.
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if ! delete_one "$line"; then failed=1; fi
    if [[ $DRY_RUN -eq 0 ]]; then
      sleep 0.5
    fi
  done <<< "$selection"
  return "$failed"
}

main "$@"
