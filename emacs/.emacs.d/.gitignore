# -*- mode: gitignore; -*-
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Org-mode
.org-id-locations
*_archive

# flymake-mode
*_flymake.*

# eshell files
/eshell/history
/eshell/lastdir

# elpa packages
/elpa/

# reftex files
*.rel

# AUCTeX auto folder
/auto/

# cask packages
.cask/
dist/

# Flycheck
flycheck_*.el

# server auth directory
/server/

# projectiles files
.projectile

# directory configuration
.dir-locals.el

# network security
/network-security.data

# ido
ido.last

# native-compilation cache (Emacs 28+)
/eln-cache/

# tree-sitter grammars, built by treesit-install-language-grammar (Emacs 29+)
/tree-sitter/

# lsp-mode session state
/.lsp-session-v1

# dap-mode breakpoint state
/.dap-breakpoints

# url library cache
/url/

# machine-local Custom output (durable declarations live in
# modules/custom-settings.el; this file is loaded last if present)
/custom.el
/backups/
/auto-save/
