# OS metadata
.DS_Store

# Editor backups and autosaves
*~
.#*
#*#
*.swp
*.swo

# sed -i '' artifacts (macOS)
*-e

# Generic backup/merge artifacts
*.bak
*.orig
*.rej

# IDE workspaces
.idea/
.vscode/

# tmux runtime plugin state (tpm installs into here; tpm itself is a tracked submodule)
tmux/.tmux/plugins/*

# fish per-machine universal variable state (regenerated on first launch)
fish/.config/fish/fish_variables
fish/.config/fish/local.fish

# Cross-agent coordination scratch (per-directory, ephemeral)
.context/
